# Momentum Trading Bot - Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# Polygon.io API key (get at https://polygon.io/dashboard/signup)
POLYGON_API_KEY=your_polygon_api_key_here

# Alpaca API keys (get at https://app.alpaca.markets/signup)
# Use paper trading keys first!
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# Optional: Finnhub API key (get at https://finnhub.io/register)
# FINNHUB_API_KEY=your_finnhub_api_key_here

# Optional: Override config values via environment
# TRADING_RUN_MODE=paper
# TRADING_LOG_LEVEL=DEBUG
# TRADING_RISK__RISK_PER_TRADE_PCT=0.5
