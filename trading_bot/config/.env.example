# =============================================================================
# Momentum Trading Bot - Environment Variables
# =============================================================================
# Copy this file to the project root as .env:
#   cp trading_bot/config/.env.example .env
#
# NEVER commit .env to version control (it's in .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Polygon.io API Key
# ---------------------------------------------------------------------------
# Used for: real-time market snapshots, pre-market gainers, news/catalyst data
# Sign up:  https://polygon.io/dashboard/signup
# Free tier: 5 API calls/minute (sufficient for paper trading)
# Paid tier: recommended for live trading (faster data, higher limits)
#
# Note: Free plan cannot access the gainers snapshot endpoint. The bot
# automatically falls back to Alpaca movers + Yahoo Finance screener.
#
POLYGON_API_KEY=your_polygon_api_key_here

# ---------------------------------------------------------------------------
# REQUIRED: Alpaca API Keys (for order execution + market data)
# ---------------------------------------------------------------------------
# Used for: submitting orders, account/equity info, position management,
#           movers screener, most-active screener, batch snapshots
# Sign up:  https://app.alpaca.markets/signup
# Cost:     FREE for both paper and live trading
#
# IMPORTANT: Use your PAPER trading keys first (from the paper trading dashboard).
# To find your keys:
#   1. Log in to https://app.alpaca.markets
#   2. Switch to "Paper Trading" in the left sidebar
#   3. Go to "API Keys" and generate a new key pair
#
# For live trading, switch to your live API keys and set alpaca_paper=false
# in config.yaml. The bot will require explicit confirmation before trading.
#
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# ---------------------------------------------------------------------------
# OPTIONAL: Webhook URL for trade notifications (Slack, Discord, etc.)
# ---------------------------------------------------------------------------
# Receives JSON payloads for trade opens/closes, circuit breaker events,
# daily summaries, and errors. See README for payload format.
#
# TRADING_NOTIFICATIONS__ENABLED=true
# TRADING_NOTIFICATIONS__WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---------------------------------------------------------------------------
# OPTIONAL: LLM catalyst scout for the agent gate (default OFF)
# ---------------------------------------------------------------------------
# The scout only classifies the catalyst behind a gap; it never trades.
# Keys are read from the environment at call time and never stored in config.
# Enable with TRADING_AGENTS__LLM__ENABLED=true after `pip install ".[llm]"`.
#
# OPENAI_API_KEY=your_openai_api_key_here          # provider: openai
# ANTHROPIC_API_KEY=your_anthropic_api_key_here    # provider: anthropic
# TRADING_AGENTS__LLM__ENABLED=false
# TRADING_AGENTS__LLM__PROVIDER=openai             # openai | anthropic
# TRADING_AGENTS__LLM__MODEL=gpt-4.1-mini          # claude-* for anthropic
# TRADING_AGENTS__REQUIRE_SCOUT=false
# TRADING_AGENTS__ENABLED=true                     # false = gate is a no-op

# ---------------------------------------------------------------------------
# OPTIONAL: Dashboard port (default 8080, set to 0 to disable)
# ---------------------------------------------------------------------------
# TRADING_DASHBOARD_PORT=8080

# ---------------------------------------------------------------------------
# OPTIONAL: Logging
# ---------------------------------------------------------------------------
# TRADING_LOG_LEVEL=INFO
# TRADING_LOG_JSON=true          # JSON format (recommended for Railway/Docker)

# ---------------------------------------------------------------------------
# OPTIONAL: Override any config.yaml value via environment variables
# ---------------------------------------------------------------------------
# Prefix: TRADING_
# Nested delimiter: __ (double underscore)
#
# Examples:
# TRADING_RUN_MODE=paper                       # Run mode: paper, backtest, live
# TRADING_LOG_LEVEL=DEBUG                      # Log verbosity
# TRADING_RISK__RISK_PER_TRADE_PCT=0.5         # Risk 0.5% per trade (default 1%)
# TRADING_SCANNER__MIN_GAP_PCT=4               # Minimum gap-up % (default 4%)
# TRADING_SCANNER__MIN_RELATIVE_VOLUME=2       # Min relative volume (default 2x)
# TRADING_SCANNER__MAX_PRICE=50                # Max price (default $50)
# TRADING_SCANNER__MAX_FLOAT_SHARES=50000000   # Max float 50M (max allowed)
# TRADING_RISK__MAX_OPEN_POSITIONS=2           # Max 2 concurrent positions
# TRADING_STARTING_CAPITAL=500                 # Starting capital for paper mode

# ---------------------------------------------------------------------------
# PRIVATE PAPER LAUNCH (recommended)
# ---------------------------------------------------------------------------
# Keep every non-health API route behind server-held bearer credentials.
# Generate independent high-entropy values for the two keys below.
#
# TRADING_PRIVATE_MODE=true
# TRADING_DASHBOARD_API_KEY=generate-a-32-byte-or-longer-random-secret
# TRADING_API_KEY=generate-a-different-32-byte-or-longer-random-secret
# TRADING_RUN_MODE=paper
# TRADING_LIVE_TRADING_ENABLED=false
# DASHBOARD_CORS_ORIGINS=https://your-private-vercel-domain.example
# TRADING_SAAS_DATA_MODE=alpaca
# TRADING_SAAS_AUTO_GENERATE=true
# TRADING_SAAS_GENERATION_INTERVAL_SECONDS=1800
# TRADING_SAAS_REPORTS_DIR=/app/data/saas_reports

# ---------------------------------------------------------------------------
# ANALYTICS API (Railway backend; private during paper validation)
# ---------------------------------------------------------------------------
# These are for the public signals API surface (trading-bot-api), not the
# core trading bot. Set these on Railway (and locally when testing the SaaS).
#
# Fastest way: run `python scripts/momentumforge_api_key.py` — it gives you
# the exact commands and a ready-to-use key.
#
# Quick single-key method (great for getting started):
# TRADING_API_KEY=your-32-byte-urlsafe-key-here
#
# Production multi-user method (recommended once you have a volume):
# TRADING_API_KEYS_MANIFEST_PATH=/app/data/api_keys_manifest.jsonl
# TRADING_API_KEYS_REVOKED_PATH=/app/data/api_keys_revoked.jsonl
#
# Premium override (comma separated raw keys):
# TRADING_API_PREMIUM_KEYS=key1,key2
#
# Usage enforcement (Phase 8):
# TRADING_USAGE_ENFORCEMENT_ENABLED=true
# TRADING_FREE_DAILY_REQUEST_LIMIT=50
# TRADING_PREMIUM_DAILY_REQUEST_LIMIT=1000
