# =============================================================================
# Momentum Trading Bot - Environment Variables
# =============================================================================
# Copy this file to the project root as .env:
#   cp trading_bot/config/.env.example .env
#
# NEVER commit .env to version control (it's in .gitignore).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED: Polygon.io API Key
# ---------------------------------------------------------------------------
# Used for: real-time market snapshots, pre-market gainers, news/catalyst data
# Sign up:  https://polygon.io/dashboard/signup
# Free tier: 5 API calls/minute (sufficient for paper trading)
# Paid tier: recommended for live trading (faster data, higher limits)
#
POLYGON_API_KEY=your_polygon_api_key_here

# ---------------------------------------------------------------------------
# REQUIRED: Alpaca API Keys (for order execution)
# ---------------------------------------------------------------------------
# Used for: submitting orders, account/equity info, position management
# Sign up:  https://app.alpaca.markets/signup
# Cost:     FREE for both paper and live trading
#
# IMPORTANT: Use your PAPER trading keys first (from the paper trading dashboard).
# To find your keys:
#   1. Log in to https://app.alpaca.markets
#   2. Switch to "Paper Trading" in the left sidebar
#   3. Go to "API Keys" and generate a new key pair
#
# For live trading, switch to your live API keys and set alpaca_paper=false
# in config.yaml. The bot will require explicit confirmation before trading.
#
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here

# ---------------------------------------------------------------------------
# OPTIONAL: Finnhub API Key (alternative news/catalyst source)
# ---------------------------------------------------------------------------
# Used for: supplemental news headlines and catalyst detection
# Sign up:  https://finnhub.io/register
# Free tier: 60 API calls/minute
# Not required -- Polygon news is used by default.
#
# FINNHUB_API_KEY=your_finnhub_api_key_here

# ---------------------------------------------------------------------------
# OPTIONAL: Webhook URL for trade notifications (Slack, Discord, etc.)
# ---------------------------------------------------------------------------
# Receives JSON payloads for trade opens/closes, circuit breaker events,
# daily summaries, and errors. See README for payload format.
#
# TRADING_NOTIFICATIONS__ENABLED=true
# TRADING_NOTIFICATIONS__WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ---------------------------------------------------------------------------
# OPTIONAL: Override any config.yaml value via environment variables
# ---------------------------------------------------------------------------
# Prefix: TRADING_
# Nested delimiter: __ (double underscore)
#
# Examples:
# TRADING_RUN_MODE=paper                       # Run mode: paper, backtest, live
# TRADING_LOG_LEVEL=DEBUG                      # Log verbosity
# TRADING_RISK__RISK_PER_TRADE_PCT=0.5         # Risk 0.5% per trade (default 1%)
# TRADING_SCANNER__MIN_GAP_PCT=15              # Minimum gap-up % (default 10%)
# TRADING_SCANNER__MAX_FLOAT_SHARES=30000000   # Max float 30M (default 50M)
# TRADING_RISK__MAX_OPEN_POSITIONS=2           # Max 2 concurrent positions
# TRADING_STARTING_CAPITAL=500                 # Starting capital for paper mode
