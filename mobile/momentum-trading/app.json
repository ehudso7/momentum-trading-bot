{
  "expo": {
    "name": "Momentum",
    "slug": "momentum-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momentum-trading",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E27"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentumtrading.pro",
      "buildNumber": "6",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Allow Face ID for secure authentication"
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.momentumtrading.pro",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E27"
      },
      "permissions": [
        "VIBRATE",
        "USE_FINGERPRINT",
        "USE_BIOMETRIC"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-notifications",
      "expo-secure-store",
      "expo-updates"
    ],
    "extra": {
      "releaseStatus": "quarantined-private-web-only",
      "eas": {
        "projectId": "50c9a7cc-e370-47a4-9eb3-984591cc7674"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "ehudso7"
  }
}
