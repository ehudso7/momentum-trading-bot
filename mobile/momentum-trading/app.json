{
  "expo": {
    "name": "Momentum",
    "slug": "momentum-trading",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "momentum-trading",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0E27"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.momentumtrading.pro",
      "buildNumber": "6",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera access to scan documents and verify identity",
        "NSFaceIDUsageDescription": "Allow Face ID for secure authentication",
        "NSLocationWhenInUseUsageDescription": "Allow location access for regional market data"
      },
      "config": {
        "usesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:momentum-trading-bot-production.up.railway.app"
      ]
    },
    "android": {
      "package": "com.momentumtrading.pro",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0E27"
      },
      "permissions": [
        "CAMERA",
        "VIBRATE",
        "USE_FINGERPRINT",
        "USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "momentum-trading-bot-production.up.railway.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-notifications",
      "expo-secure-store",
      "expo-updates",
      "expo-status-bar"
    ],
    "extra": {
      "apiUrl": "https://momentum-trading-bot-production.up.railway.app",
      "eas": {
        "projectId": "50c9a7cc-e370-47a4-9eb3-984591cc7674"
      }
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "owner": "ehudso7"
  }
}
