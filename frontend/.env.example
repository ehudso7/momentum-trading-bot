# Railway Backend (required)
NEXT_PUBLIC_BACKEND_URL=https://momentum-trading-bot-production.up.railway.app

# Trading bot dashboard API (optional — defaults to BACKEND_URL)
# Use a separate URL if your trading dashboard runs on a different Railway service.
NEXT_PUBLIC_DASHBOARD_URL=

# Private owner boundary. Server-only: never prefix these with NEXT_PUBLIC.
# Public mode is intentionally two-key gated: keep both values below for the
# private paper release. A future public launch requires an explicit reviewed
# change to BOTH TRADING_PRIVATE_MODE=false and TRADING_PUBLIC_PRODUCT_ENABLED=true.
TRADING_PRIVATE_MODE=true
TRADING_PUBLIC_PRODUCT_ENABLED=false
TRADING_PRIVATE_OWNER_EMAILS=owner@example.com
TRADING_BACKEND_URL=https://momentum-trading-bot-production.up.railway.app
TRADING_DASHBOARD_URL=https://momentum-bot-core-production.up.railway.app
TRADING_BACKEND_API_KEY=must-match-the-analytics-service-TRADING_API_KEY
TRADING_DASHBOARD_API_KEY=must-match-the-core-service-key

# Supabase Auth (required for the private owner login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Deferred public-product settings. These are not required for the private
# paper release and should remain unset unless the public launch gate is
# deliberately reviewed and enabled.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# TRADING_PROVISION_SECRET=your-provision-secret
# NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...

# Sentry error monitoring (optional — Sentry is a silent no-op when unset).
# Client-side DSN (safe to expose; also used as server fallback):
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-only DSN override (optional):
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source-map upload during builds (optional — build is inert without these):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_...
