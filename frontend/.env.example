# Railway Backend (required)
NEXT_PUBLIC_BACKEND_URL=https://momentum-trading-bot-production.up.railway.app

# Trading bot dashboard API (optional — defaults to BACKEND_URL)
# Use a separate URL if your trading dashboard runs on a different Railway service
NEXT_PUBLIC_DASHBOARD_URL=

# Supabase Auth (required for login/signup/trade sync)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe (required for billing webhook — server-side only)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role key (server-side only — NEVER expose to the client).
# Used by the Stripe webhook to update user app_metadata (plan, customer id).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Backend key-provisioning secret (server-side only — NEVER prefix with
# NEXT_PUBLIC). Must match TRADING_PROVISION_SECRET on the Railway backend;
# used by /api/keys/provision to auto-issue per-user API keys.
TRADING_PROVISION_SECRET=your-provision-secret

# Stripe price IDs (optional — used by backend checkout)
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID=price_...
# Sentry error monitoring (optional — Sentry is a silent no-op when unset).
# Client-side DSN (safe to expose; also used as server fallback):
# NEXT_PUBLIC_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Server-only DSN override (optional):
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# Source-map upload during builds (optional — build is inert without these):
# SENTRY_ORG=your-org
# SENTRY_PROJECT=your-project
# SENTRY_AUTH_TOKEN=sntrys_...
